# 사이트 URL (Vercel 배포 후 설정)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Giscus 댓글 (https://giscus.app 에서 설정값 확인)
NEXT_PUBLIC_GISCUS_REPO=username/stock-blog
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 주식 API (선택사항 - Yahoo Finance는 키 불필요)
# STOCK_API_KEY=

# 구글 시트 (블로그 소재 조사용)
GOOGLE_SHEET_ID=                          # 스프레드시트 URL의 /d/<여기>/edit 부분
GOOGLE_CREDENTIALS_PATH=./credentials.json # Service Account 키 파일 경로
